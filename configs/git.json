          },
          "path": {
            "type": "string",
            "description": "Pathspec to stash"
          },
          "keep_index": {
            "type": "boolean",
            "description": "Keep staged changes in the index"
          },
          "staged": {
            "type": "boolean",
            "description": "Stash only staged changes"
          },
          "include_untracked": {
