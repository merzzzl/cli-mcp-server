          },
          "dry_run": {
            "type": "boolean",
            "description": "Show what would be removed"
          },
          "recursive": {
            "type": "boolean",
            "description": "Allow recursive directory removal"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "command": [
        "git",
        "rm",
        "{{if .cached}}--cached{{end}}",
        "{{if .force}}--force{{end}}",
        "{{if .dry_run}}--dry-run{{end}}",
        "{{if .recursive}}-r{{end}}",
        "--",
        "{{.path}}"
      ]
    },
    {
      "name": "git_show",
      "description": "Show a Git object",
