          "path": {
            "type": "string",
            "description": "Pathspec to reset"
          },
          "recurse_submodules": {
            "type": "boolean",
            "description": "Recursively reset active submodules"
          }
        },
        "additionalProperties": false
      },
      "command": [
        "git",
        "reset",
        "{{with .mode}}--{{.}}{{end}}",
        "{{if .recurse_submodules}}--recurse-submodules{{end}}",
        "{{with .target}}{{.}}{{end}}",
        "{{with .path}}--{{end}}",
        "{{with .path}}{{.}}{{end}}"
      ]
    },
    {
      "name": "git_restore",
      "description": "Restore working tree or index files",
      "input": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Pathspec to restore",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "description": "Tree used as the restore source"
          },
          "staged": {
            "type": "boolean",
            "description": "Restore the index"
          },
          "worktree": {
            "type": "boolean",
            "description": "Restore the working tree"
          },
          "ours": {
            "type": "boolean",
            "description": "Use the ours version for unmerged paths"
          },
          "theirs": {
            "type": "boolean",
            "description": "Use the theirs version for unmerged paths"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "command": [
        "git",
        "restore",
        "{{with .source}}--source={{.}}{{end}}",
        "{{if .staged}}--staged{{end}}",
        "{{if .worktree}}--worktree{{end}}",
        "{{if .ours}}--ours{{end}}",
        "{{if .theirs}}--theirs{{end}}",
        "--",
        "{{.path}}"
      ]
    },
    {
      "name": "git_revert",
      "description": "Create a commit that reverses an existing commit",
      "input": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "Revert operation",
            "enum": [
              "revert",
              "continue",
              "abort",
              "quit"
            ]
          },
          "commit": {
            "type": "string",
            "description": "Commit to revert"
          },
          "no_commit": {
            "type": "boolean",
            "description": "Apply changes without committing"
          },
          "edit": {
            "type": "boolean",
            "description": "Edit the commit message"
          },
          "mainline": {
            "type": "integer",
            "description": "Parent number for a merge commit",
            "minimum": 1
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "command": [
        "git",
        "revert",
        "{{if eq .action \"continue\"}}--continue{{end}}",
        "{{if eq .action \"abort\"}}--abort{{end}}",
        "{{if eq .action \"quit\"}}--quit{{end}}",
        "{{if .no_commit}}--no-commit{{end}}",
        "{{if .edit}}--edit{{end}}",
        "{{with .mainline}}--mainline={{.}}{{end}}",
        "{{if eq .action \"revert\"}}{{.commit}}{{end}}"
      ]
    },
    {
      "name": "git_rm",
      "description": "Remove files from the index and working tree",
      "input": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Pathspec to remove",
            "minLength": 1
          },
          "cached": {
            "type": "boolean",
            "description": "Remove only from the index"
          },
          "force": {
            "type": "boolean",
