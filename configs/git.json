        "{{with .new_branch}}--branch={{.}}{{end}}",
        "{{with .path}}{{.}}{{end}}",
        "{{with .destination}}{{.}}{{end}}",
        "{{with .commit}}{{.}}{{end}}"
      ]
    },
    {
      "name": "git_remote",
      "description": "Manage tracked remote repositories",
      "input": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "Remote operation",
            "enum": [
              "list",
              "add",
              "remove",
              "rename",
              "get-url",
              "set-url",
              "show",
              "prune",
              "update"
            ]
          },
          "name": {
            "type": "string",
