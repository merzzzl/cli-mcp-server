    {
      "name": "git_worktree",
      "description": "Manage linked working trees",
      "input": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "Worktree operation",
            "enum": [
              "add",
              "list",
              "lock",
              "move",
              "prune",
              "remove",
              "repair",
              "unlock"
            ]
          },
          "path": {
            "type": "string",
            "description": "Worktree path"
          },
          "destination": {
            "type": "string",
            "description": "Destination path for move"
          },
          "commit": {
            "type": "string",
            "description": "Commit or branch checked out by add"
          },
          "new_branch": {
            "type": "string",
            "description": "New branch created by add"
          },
          "force": {
            "type": "boolean",
            "description": "Force the operation"
          },
          "detach": {
            "type": "boolean",
            "description": "Create a detached worktree"
          },
          "porcelain": {
            "type": "boolean",
            "description": "Use stable machine-readable output"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "command": [
