        "{{if .include_untracked}}--include-untracked{{end}}",
        "{{if .all}}--all{{end}}",
        "{{with .message}}--message{{end}}",
        "{{with .message}}{{.}}{{end}}",
        "{{with .stash}}{{.}}{{end}}",
        "{{with .path}}--{{end}}",
        "{{with .path}}{{.}}{{end}}"
      ]
    },
    {
      "name": "git_status",
      "description": "Show working tree status",
