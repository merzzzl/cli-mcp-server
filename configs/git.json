        "{{with .format}}--format={{.}}{{end}}",
        "{{if .no_patch}}--no-patch{{end}}",
        "{{with .object}}{{.}}{{end}}"
      ]
    },
    {
      "name": "git_stash",
      "description": "Manage stashed working tree changes",
      "input": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "Stash operation",
